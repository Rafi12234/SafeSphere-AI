# LOCAL DEVELOPMENT ONLY - copy to .env and update values
DATABASE_URL=postgresql+psycopg://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/safesphere_ai
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_HOURS=8

# Phase 2 - Facebook Integration
FACEBOOK_APP_ID=YOUR_APP_ID
FACEBOOK_APP_SECRET=YOUR_APP_SECRET
FACEBOOK_CONFIG_ID=YOUR_CONFIGURATION_ID
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/facebook/callback
FACEBOOK_GRAPH_VERSION=v27.0
FACEBOOK_MOCK=false
FACEBOOK_TOKEN_ENCRYPTION_KEY=YOUR_GENERATED_KEY