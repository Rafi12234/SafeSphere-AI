# Copy this example to .env and fill actual local secrets. NEVER commit .env.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/safesphere_ai
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_HOURS=8

# Phase 2: Meta Facebook Login for Business
FACEBOOK_APP_ID=YOUR_META_APP_ID
FACEBOOK_APP_SECRET=YOUR_META_APP_SECRET
FACEBOOK_CONFIG_ID=YOUR_CONFIGURATION_ID
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/facebook/callback
FACEBOOK_GRAPH_VERSION=v27.0
FACEBOOK_TOKEN_ENCRYPTION_KEY=YOUR_RANDOM_FERNET_KEY
# Set to true ONLY if you want the separate, explicitly labelled demo connection.
FACEBOOK_MOCK=false
